      "expected": {
        "cards_count": 1,
        "card_types": ["study_material"],
        "study_material_structure": {
          "type": "study_material",
          "title": "string, 非空",
          "subtitle": "string, 包含考试名",
          "days": [],
          "items": [],
          "qrcode_url": "",
          "study_material": [
            {
              "module_title": "string, 10-20字",
              "key_points": ["string, 3-5条, 每条点明出题方向"],
              "memory_tips": ["string, 1-3条, 谐音/联想/画面感"],
              "source": "knowledge_base | llm_search"
            }
          ]
        }
      }
    }
  ],
  "dify_test_run_guide": {
    "step_1": "打开 Dify 后台 → 备考卡片生成 Workflow → 点击右上角「运行」",
    "step_2": "在「输入变量」面板中按 test_cases 填入对应字段值",
    "step_3": "cards 字段粘贴 test_cases 中的 JSON 字符串（注意是整个数组的 JSON 序列化）",
    "step_4": "点击「运行」查看各节点输出，验证 CODE_1 → CODE_A → LLM → CODE_2 全链路",
    "step_5": "重点检查项：",
    "checks": [
      "CODE_1 输出 enriched_cards 中每张卡片包含 target_audience / theme / include_study_material 字段",
      "CODE_A 输出的 system_prompt 包含「目标受众适配」和「内容主题方向」段落（当参数非空时）",
      "CODE_A 对 study_material 类型输出了正确的 prompt 格式",
      "LLM 生成的 study_material 卡片包含 module_title / key_points / memory_tips / source",
      "CODE_2 的 cards 输出包含 study_material 类型的卡片，结构校验通过"
    ]
  }
}
