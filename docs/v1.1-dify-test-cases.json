{
  "test_suite": "V1.1 备考软文图片生成 — Dify Workflow 测试用例",
  "version": "1.1.0",
  "created": "2026-06-12",
  "api_endpoint": "POST /v1/workflows/run",
  "workflow_variables": [
    "exam_name",
    "exam_date",
    "cards",
    "role",
    "countdown_days",
    "phase_1_end",
    "phase_2_end",
    "today_date",
    "target_audience",
    "theme",
    "include_study_material"
  ],
  "test_cases": [
    {
      "id": "TC-01",
      "name": "含备考资料(7张) + 在职备考 + 主题预设",
      "description": "选择在职备考人群 + 考前30天冲刺攻略主题 + 含备考资料7张预设，验证 study_material 卡片生成及人群/主题注入",
      "inputs": {
        "exam_name": "执业医师资格证",
        "exam_date": "2026-08-02",
        "cards": "[{\"type\":\"cover\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\"},{\"type\":\"plan\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\"},{\"type\":\"plan\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\"},{\"type\":\"subjects\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\"},{\"type\":\"study_material\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\",\"study_material\":[]},{\"type\":\"notice\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\"},{\"type\":\"cta\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\"}]",
        "role": "小红书-医考号",
        "countdown_days": 51,
        "phase_1_end": "2026-06-15",
        "phase_2_end": "2026-07-13",
        "today_date": "2026-06-12",
        "target_audience": "在职备考",
        "theme": "考前 30 天冲刺攻略",
        "include_study_material": true
      },
      "expected": {
        "cards_count": 7,
        "card_types": ["cover", "plan", "plan", "subjects", "study_material", "notice", "cta"],
        "study_material_checks": [
          "study_material 数组非空，包含 2-3 个知识模块",
          "每个模块有 module_title、key_points(≥3条)、memory_tips、source",
          "source 字段为 knowledge_base 或 llm_search",
          "文案语气体现在职备考特点（时间碎片化、通勤学习等）",
          "内容围绕「考前 30 天冲刺攻略」主题"
        ],
        "audience_checks": [
          "封面标题包含「假如你从...开始备考」句式",
          "计划卡片提到通勤/午休等在职场景",
          "CTA 卡片共情陈述体现在职备考痛点"
        ]
      }
    },
    {
      "id": "TC-02",
      "name": "含备考资料(7张) + 宝妈备考 + 自定义主题",
      "description": "选择宝妈备考人群 + 自由输入主题「带娃备考两不误，宝妈的上岸之路」，验证自定义主题生效",
      "inputs": {
        "exam_name": "执业医师资格证",
        "exam_date": "2026-08-02",
        "cards": "[{\"type\":\"cover\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\"},{\"type\":\"plan\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\"},{\"type\":\"plan\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\"},{\"type\":\"subjects\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\"},{\"type\":\"study_material\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\",\"study_material\":[]},{\"type\":\"notice\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\"},{\"type\":\"cta\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\"}]",
        "role": "小红书-医考号",
        "countdown_days": 51,
        "phase_1_end": "2026-06-15",
        "phase_2_end": "2026-07-13",
        "today_date": "2026-06-12",
        "target_audience": "宝妈备考",
        "theme": "带娃备考两不误，宝妈的上岸之路",
        "include_study_material": true
      },
      "expected": {
        "cards_count": 7,
        "card_types": ["cover", "plan", "plan", "subjects", "study_material", "notice", "cta"],
        "study_material_checks": [
          "study_material 数组非空",
          "文案语气体现宝妈备考特点（带娃间隙学习、时间灵活性）",
          "内容围绕「带娃备考两不误」主题"
        ],
        "audience_checks": [
          "计划卡片提到带娃间隙、送孩子上课等场景",
          "学习资料记忆方法考虑宝妈碎片化学习特点"
        ]
      }
    },
    {
      "id": "TC-03",
      "name": "6 张标准预设 + 零基础 + 无主题（校验拦截）",
      "description": "选择零基础人群 + 不填主题，前端应拦截阻止生成，此用例验证 Dify 收到空 theme 时的兜底行为",
      "inputs": {
        "exam_name": "护士资格证",
        "exam_date": "2026-07-15",
        "cards": "[{\"type\":\"cover\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\"},{\"type\":\"plan\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\"},{\"type\":\"plan\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\"},{\"type\":\"priority\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\"},{\"type\":\"resources\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\"},{\"type\":\"cta\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\"}]",
        "role": "小红书-医考号",
        "countdown_days": 33,
        "phase_1_end": "2026-06-18",
        "phase_2_end": "2026-07-01",
        "today_date": "2026-06-12",
        "target_audience": "零基础",
        "theme": "",
        "include_study_material": false
      },
      "expected": {
        "cards_count": 6,
        "card_types": ["cover", "plan", "plan", "priority", "resources", "cta"],
        "note": "theme 为空时，TONE_BLOCK 不注入主题段落，LLM 正常生成但不限定主题方向",
        "audience_checks": [
          "文案语气体现零基础特点（循序渐进、基础概念解释）",
          "不出现高深术语轰炸"
        ]
      }
    },
    {
      "id": "TC-04",
      "name": "5 张精简预设 + 非科班 + 自定义人群输入",
      "description": "自由输入人群「大龄转行备考」+ 自由输入主题「从零开始，6 个月拿下教资」，验证自定义人群文本透传",
      "inputs": {
        "exam_name": "教师资格证",
        "exam_date": "2026-10-25",
        "cards": "[{\"type\":\"cover\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\"},{\"type\":\"plan\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\"},{\"type\":\"subjects\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\"},{\"type\":\"notice\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\"},{\"type\":\"cta\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\"}]",
        "role": "小红书-考研号",
        "countdown_days": 135,
        "phase_1_end": "2026-09-01",
        "phase_2_end": "2026-10-05",
        "today_date": "2026-06-12",
        "target_audience": "大龄转行备考",
        "theme": "从零开始，6 个月拿下教资",
        "include_study_material": false
      },
      "expected": {
        "cards_count": 5,
        "card_types": ["cover", "plan", "subjects", "notice", "cta"],
        "audience_checks": [
          "自定义人群文本透传到 LLM，AUDIENCE_PROFILES 未匹配时跳过人群适配段落",
          "自定义主题文本注入到 TONE_BLOCK 主题段落",
          "内容围绕「从零开始，6 个月拿下教资」"
        ]
      }
    },
    {
      "id": "TC-05",
      "name": "知识型预设 + 全部不选（人群/主题均为空）",
      "description": "人群和主题都不选，验证兜底行为——CODE_A 不注入人群/主题段落，LLM 正常生成通用内容",
      "inputs": {
        "exam_name": "注册安全工程师",
        "exam_date": "2026-10-25",
        "cards": "[{\"type\":\"cover\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\"},{\"type\":\"subjects\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\"},{\"type\":\"priority\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\"},{\"type\":\"mnemonics\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\"},{\"type\":\"resources\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\"},{\"type\":\"cta\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\"}]",
        "role": "公众号主编",
        "countdown_days": 135,
        "phase_1_end": "2026-09-01",
        "phase_2_end": "2026-10-05",
        "today_date": "2026-06-12",
        "target_audience": "",
        "theme": "",
        "include_study_material": false
      },
      "expected": {
        "cards_count": 6,
        "card_types": ["cover", "subjects", "priority", "mnemonics", "resources", "cta"],
        "note": "人群/主题均为空时，TONE_BLOCK 不注入对应段落，LLM 生成通用内容；前端应已在 theme 为空时拦截阻止生成"
      }
    },
    {
      "id": "TC-06",
      "name": "仅 study_material 卡片 + 在职备考 + 单卡生成测试",
      "description": "单独测试 study_material 卡片的 prompt 是否输出正确结构，仅包含一张 study_material 卡片",
      "inputs": {
        "exam_name": "执业医师资格证",
        "exam_date": "2026-08-02",
        "cards": "[{\"type\":\"study_material\",\"title\":\"\",\"subtitle\":\"\",\"days\":[],\"items\":[],\"qrcode_url\":\"\",\"study_material\":[]}]",
        "role": "小红书-医考号",
        "countdown_days": 51,
        "phase_1_end": "2026-06-15",
        "phase_2_end": "2026-07-13",
        "today_date": "2026-06-12",
        "target_audience": "在职备考",
        "theme": "考前 30 天冲刺攻略",
        "include_study_material": true
