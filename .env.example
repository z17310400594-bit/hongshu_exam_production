# 复制为 .env 后填入真实值
# 所有密码不得硬编码在代码中 — 见 DECISIONS.md K001-K004

DB_HOST=localhost
DB_PORT=5434
DB_USER=v2_user
DB_PASSWORD=v2_dev_password
DB_NAME=knowledge_platform_v2

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=knowledge-assets

REDIS_URL=redis://localhost:6379/0

# Backend-only model gateway. Keep local for normal dev/test.
GENERATION_PROVIDER=local
DIFY_API_URL=
DIFY_API_KEY=
MODEL_GATEWAY_TIMEOUT_SECONDS=30

# Frontend public config — never commit real Dify keys.
TARO_APP_API_BASE_URL=http://localhost:8000
TARO_APP_ORG_CODE=org_teaching_materials
TARO_APP_USE_V2_CERTIFICATE_API=true
TARO_APP_GENERATION_COLLECTIONS=coll_internal
TARO_APP_GENERATION_KNOWLEDGE_POINTS=
